ENVIRONMENT=prod
DEBUG=false

DATABASE_URL=postgresql+asyncpg://laxify:CHANGE_ME@db:5432/laxify
REDIS_URL=redis://cache:6379/0

# Обязательно замените: любая случайная строка длиной от 32 символов
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# iOS client ID из Google Cloud Console
GOOGLE_CLIENT_IDS=["429672118190-bpqosadr0dorkdjocdm0vntflcq4mhbm.apps.googleusercontent.com"]

# Ключи доступа к музыке. Можно оставить пустым и добавить через админку.
YANDEX_TOKENS=[]

# Прокси музыки — включать только когда сервер имеет российский IP.
# Сейчас сервер во Франкфурте, поэтому выключено: иначе музыка перестанет
# грузиться вообще, а не только под VPN.
MUSIC_PROXY_ENABLED=false
MUSIC_PROXY_UPSTREAM=

# Google sub администраторов (узнать можно в логах после первого входа)
ADMIN_GOOGLE_SUBS=[]

CORS_ORIGINS=[]
